    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protected-paths.sh",
            "statusMessage": "Checking command against protected paths"
          },
          {
            "type": "command",
            "if": "Bash(curl:*)",
            "command": "bash ~/.claude/hooks/curl-guard.sh",
            "statusMessage": "Classifying curl command"
          },
          {
            "type": "command",
            "if": "Bash(awk:*)",
            "command": "python ~/.claude/hooks/awk-guard.py",
            "statusMessage": "Classifying awk command"
          }
        ]
      }
    ]
  },
  "skillListingBudgetFraction": 0.02,
  "enableArtifact": false,
  "enableWorkflows": false,
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false
}
